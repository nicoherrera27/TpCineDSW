model Funcion {
  Id          Int              @id @default(autoincrement())
  Estado      String
  Fecha       DateTime?        @db.Date
  horarios    Horario[]
  categoria   CategoriaFuncion @relation(fields: [categoriaId], references: [Id])
  categoriaId Int
  sala        Sala             @relation(fields: [salaId], references: [Id])
  salaId      Int
}
